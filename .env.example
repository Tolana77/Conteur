# Active explicitement la passerelle une fois le fournisseur choisi.
AI_GATEWAY_ENABLED=false

# Point d'entrée compatible OpenAI du fournisseur choisi.
# Exemple attendu: https://api.example.com/v1/chat/completions
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_MAX_TOKENS=700

# Recommandé après le premier déploiement : l'URL publique exacte du site.
AI_ALLOWED_ORIGIN=

# Limite indicative par instance serverless, pas un mécanisme d'authentification.
AI_MAX_REQUESTS_PER_MINUTE=12

# Clés publiques du projet Supabase utilisé pour les salons multijoueurs.
# Ne jamais placer la clé service_role dans une variable VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
